---
import Socials from './Socials.astro';
import { related, site, url } from '../lib/site';
---
<footer class="ft">
  <div class="wrap">
    <p class="ft-name">{site.nameEn}</p>
    <Socials />
    <ul class="rel">
      {related.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.name}</a></li>)}
      <li><a href={url('rss.xml')}>RSS</a></li>
    </ul>
    <p class="copy">© {new Date().getFullYear()} Jun Inohara / Blue Green Music Lab.</p>
  </div>
</footer>
<style>
  .ft { border-top: 1px solid var(--line); padding: 56px 0 40px; text-align: center; background: var(--bg-2); }
  .ft-name { font-family: var(--serif); font-size: 1.6rem; letter-spacing: .15em; margin: 0 0 18px; }
  .rel { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: center; font-size: .85rem; color: var(--muted); }
  .rel a { text-decoration: none; }
  .copy { color: var(--muted); font-size: .75rem; margin: 24px 0 0; }
</style>
