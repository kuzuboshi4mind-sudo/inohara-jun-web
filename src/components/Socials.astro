---
import { socials } from '../lib/site';
// シンプルなSVGアイコン（外部ライブラリ不要）
const icons: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  X: '<path d="M4 4l16 16M20 4L4 20"/>',
  YouTube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>',
  Facebook: '<path d="M14 8h3V4.5h-3a4 4 0 0 0-4 4V11H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3V9a1 1 0 0 1 1-1z"/>',
  LINE: '<path d="M12 4C7 4 3 7.2 3 11.2c0 3.5 3.1 6.4 7.3 7l-.4 2.6 3.4-2.5C17.8 17.9 21 14.9 21 11.2 21 7.2 17 4 12 4z"/>',
};
---
<ul class="sns">
  {socials.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.name]} />
      </a>
    </li>
  ))}
</ul>
<style>
  .sns { list-style: none; padding: 0; margin: 0; display: flex; gap: 10px; justify-content: center; }
  .sns a { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; }
  .sns a:hover { border-color: var(--accent); }
</style>
