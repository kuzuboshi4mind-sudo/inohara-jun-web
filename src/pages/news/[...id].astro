---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getNews } from '../../lib/content';
import { url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry, i) => ({ params: { id: entry.id }, props: { entry, newer: news[i - 1], older: news[i + 1] } }));
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareText = encodeURIComponent(`${entry.data.title} | 猪原純`);
---
<Base title={entry.data.title} description={entry.data.description} image={entry.data.image}>
  <article class="wrap page-head">
    <time>{formatDate(entry.data.date)}</time>
    <h1>{entry.data.title}</h1>
    {entry.data.image && <img class="cover" src={url(entry.data.image)} alt="" />}
    <div class="prose"><Content /></div>
    <p class="share">
      <span>Share</span>
      <a href={`https://x.com/intent/post?text=${shareText}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener">X</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener">Facebook</a>
      <a href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener">LINE</a>
    </p>
    <nav class="pager">
      {older ? <a href={url(`news/${older.id}/`)}>← {older.data.title}</a> : <span></span>}
      {newer ? <a href={url(`news/${newer.id}/`)}>{newer.data.title} →</a> : <span></span>}
    </nav>
    <a class="more" href={url('news/')}>News 一覧</a>
  </article>
</Base>
<style>
  article { padding-bottom: 80px; }
  time { font-family: var(--serif); color: var(--accent); font-size: 1.2rem; }
  h1 { font-size: clamp(1.4rem, 4vw, 2rem); line-height: 1.5; margin: 6px 0 32px; font-weight: 600; }
  .cover { border-radius: 6px; margin-bottom: 32px; }
  .share { display: flex; gap: 18px; align-items: center; margin: 40px 0; font-size: .9rem; color: var(--muted); }
  .share a { color: var(--accent); }
  .pager { display: flex; justify-content: space-between; gap: 20px; font-size: .88rem; border-top: 1px solid var(--line); padding-top: 20px; }
  .pager a { text-decoration: none; color: var(--muted); }
</style>
